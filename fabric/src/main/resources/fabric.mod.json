{
  "schemaVersion": 1,
  "id": "skycraft",
  "version": "${version}",
  "name": "MiSideCraft",
  "description": "Play MiSide as Steve, with Minecraft physics, blocks, mobs and inventory.",
  "authors": [
    "Mielesgames",
    "chasmlol (SkyCraft)"
  ],
  "contact": {
    "sources": "https://github.com/Mielesgames/miside-minecraft-passthrough"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.skycraft.SkyCraft"
    ],
    "client": [
      "dev.skycraft.client.SkyCraftClient"
    ]
  },
  "mixins": [
    "skycraft.mixins.json",
    {
      "config": "skycraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
